{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "gcode",
  "word": "letter",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "line"
      }
    },
    "line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "FIELD",
          "name": "line_number",
          "content": {
            "type": "SYMBOL",
            "name": "line_number"
          }
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "FIELD",
              "name": "line_number",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "line_number"
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              }
            },
            {
              "type": "REPEAT1",
              "content": {
                "type": "SYMBOL",
                "name": "statement"
              }
            }
          ]
        }
      ]
    },
    "statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "command",
          "content": {
            "type": "SYMBOL",
            "name": "command"
          }
        },
        {
          "type": "FIELD",
          "name": "parameters",
          "content": {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "parameter"
            }
          }
        }
      ]
    },
    "command": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "command_name"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        }
      ]
    },
    "command_name": {
      "type": "PATTERN",
      "value": "[GMT]"
    },
    "line_number": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "N"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        }
      ]
    },
    "parameter": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "letter",
          "content": {
            "type": "SYMBOL",
            "name": "letter"
          }
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "number"
          }
        }
      ]
    },
    "letter": {
      "type": "PATTERN",
      "value": "[A-Z]"
    },
    "number": {
      "type": "PATTERN",
      "value": "-?(\\d*\\.?\\d+)|(\\d+\\.\\d*)"
    },
    "line_comment": {
      "type": "PATTERN",
      "value": ";.*\\n"
    },
    "inline_comment": {
      "type": "PATTERN",
      "value": "\\([^)]*\\)"
    }
  },
  "extras": [
    {
      "type": "SYMBOL",
      "name": "inline_comment"
    },
    {
      "type": "SYMBOL",
      "name": "line_comment"
    },
    {
      "type": "PATTERN",
      "value": "\\s+"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}